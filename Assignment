// ======================= CITIZEN =======================
class Citizen {
    int citizenID;
    string name, contact, address;

public:
    Citizen(int id = 0, string n = "", string c = "", string a = "") {
        citizenID = id;
        name = n;
        contact = c;
        address = a;
    }

    int getID() { return citizenID; }

    void display() {
        cout << "ID: " << citizenID << "\nName: " << name
             << "\nContact: " << contact << "\nAddress: " << address << endl;
    }
};

// ======================= COMPLAINT =======================
class Complaint {
public:
    static int totalComplaints;
    static int activeComplaints;

    int complaintID;
    string category, description, location;
    string status;
    int priorityScore;
    string priorityLevel;
    string assignedTeam;

    vector<string> history;

    Complaint(int id, string cat, string desc, string loc) {
        complaintID = id;
        category = cat;
        description = desc;
        location = loc;
        status = "REPORTED";
        priorityScore = 0;
        priorityLevel = "LOW";

        totalComplaints++;
        activeComplaints++;
    }

    void addHistory(string entry) {
        history.push_back(entry);
    }

    void display() {
        cout << "\nComplaint ID: " << complaintID
             << "\nCategory: " << category
             << "\nDescription: " << description
             << "\nLocation: " << location
             << "\nStatus: " << status
             << "\nPriority: " << priorityLevel
             << "\nAssigned Team: " << assignedTeam << endl;
    }

    bool operator>(const Complaint &other) const {
        return priorityScore > other.priorityScore;
    }
};

int Complaint::totalComplaints = 0;
int Complaint::activeComplaints = 0;

// ======================= PRIORITY MANAGER =======================
class PriorityManager {
public:
    int getCategoryWeight(string cat) {
        if (cat == "Emergency") return 5;
        if (cat == "Electrical") return 4;
        if (cat == "Water") return 3;
        if (cat == "Road") return 3;
        if (cat == "Sanitation") return 2;
        return 1;
    }

    int calculatePriority(Complaint &c) {
        int weight = getCategoryWeight(c.category);
        int waitingFactor = rand() % 5;

        int score = (weight * 3) + (waitingFactor * 2);
        c.priorityScore = score;

        if (score >= 12) c.priorityLevel = "HIGH";
        else if (score >= 7) c.priorityLevel = "MEDIUM";
        else c.priorityLevel = "LOW";

        return score;
    }
};

// ======================= ABSTRACT RESPONSE TEAM =======================
class ResponseTeam {
protected:
    int teamID;
    string teamName;
    string categoryHandled;

public:
    int capacity;
    int workload;

    ResponseTeam(int id, string name, string cat, int cap) {
        teamID = id;
        teamName = name;
        categoryHandled = cat;
        capacity = cap;
        workload = 0;
    }

    virtual void respond(Complaint &c) = 0;

    bool handles(string cat) {
        return cat == categoryHandled;
    }

    virtual string getName() {
        return teamName;
    }

    ResponseTeam operator+(const ResponseTeam &other) {
        ResponseTeam temp = *this;
        temp.capacity = this->capacity + other.capacity;
        temp.workload = this->workload + other.workload;
        return temp;
    }

    virtual ~ResponseTeam() {}
};

// ======================= DERIVED CLASSES =======================
class SanitationUnit : public ResponseTeam {
public:
    SanitationUnit(int id) : ResponseTeam(id, "Sanitation Team", "Sanitation", 5) {}

