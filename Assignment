// ======================= COMPLAINT MANAGER =======================
class ComplaintManager {
public:
    vector<Complaint> complaints;

    void addComplaint(Complaint c) {
        complaints.push_back(c);
    }

    void sortComplaints() {
        sort(complaints.begin(), complaints.end(),
             [](Complaint a, Complaint b) { return a > b; });
    }

    void displayAll() {
        for (auto &c : complaints)
            c.display();
    }
};

// ======================= RESPONSE MANAGER =======================
class ResponseManager {
public:
    vector<ResponseTeam*> teams;

    void addTeam(ResponseTeam *t) {
        teams.push_back(t);
    }

    void dispatch(ComplaintManager &cm) {
        cm.sortComplaints();

        for (auto &c : cm.complaints) {
            if (c.status != "REPORTED") continue;

            ResponseTeam *best = NULL;

            for (auto t : teams) {
                if (t->handles(c.category) && t->workload < t->capacity) {
                    if (best == NULL || t->workload < best->workload)
                        best = t;
                }
            }

            if (best != NULL) {
                best->respond(c);
                c.status = "ASSIGNED";
            } else {
                cout << "No team available\n";
            }
        }
    }
};

// ======================= MAIN SYSTEM =======================
int main() {
    vector<Citizen> citizens;
    ComplaintManager cm;
    PriorityManager pm;
    ResponseManager rm;

    // Teams
    rm.addTeam(new SanitationUnit(1));
    rm.addTeam(new RoadUnit(2));
    rm.addTeam(new ElectricalUnit(3));
    rm.addTeam(new WaterUnit(4));
    rm.addTeam(new PublicSafetyUnit(5));

    int choice;
    int citizenID = 1, complaintID = 1;

    while (true) {
        cout << "\n===== SMART CIVIC SYSTEM =====\n";
        cout << "1. Register Citizen\n";
        cout << "2. Register Complaint\n";
        cout << "3. Process Complaints\n";
        cout << "4. View Complaints\n";
        cout << "5. Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        if (choice == 1) {
            string name, contact, address;
            cout << "Enter name: "; cin >> name;
            cout << "Enter contact: "; cin >> contact;
            cout << "Enter address: "; cin >> address;

            citizens.push_back(Citizen(citizenID++, name, contact, address));
        }

        else if (choice == 2) {
            string cat, desc, loc;
            cout << "Category (Sanitation/Road/Electrical/Water/Emergency): ";
            cin >> cat;
            cout << "Description: "; cin >> desc;
            cout << "Location: "; cin >> loc;

            Complaint c(complaintID++, cat, desc, loc);
            pm.calculatePriority(c);
            cm.addComplaint(c);
        }

        else if (choice == 3) {
            rm.dispatch(cm);
        }

        else if (choice == 4) {
            cm.displayAll();
        }

        else break;
    }

    return 0;
}
